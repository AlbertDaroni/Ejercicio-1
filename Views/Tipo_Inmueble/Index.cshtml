@model IEnumerable<Inmobiliaria_.Net_Core.Models.Tipo_Inmueble>

@{
    ViewData["Title"] = "Tipos de Inmueble";
}

<h1>Tipos de Inmueble</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<p>
    <a asp-action="Crear" class="btn btn-primary">
        Nuevo Tipo de Inmueble
    </a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.Nombre</td>
                <td>@item.Descripcion</td>

                <td>
                    <a asp-action="Detalles"
                       asp-route-id="@item.id"
                       class="btn btn-info btn-sm">
                        Detalles
                    </a>

                    <a asp-action="Modificar"
                       asp-route-id="@item.id"
                       class="btn btn-warning btn-sm">
                        Modificar
                    </a>

                    <a asp-action="Eliminar"
                       asp-route-id="@item.id"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>