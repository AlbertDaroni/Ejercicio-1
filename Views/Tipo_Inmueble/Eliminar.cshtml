@model Inmobiliaria_.Net_Core.Models.Tipo_Inmueble

@{
    ViewData["Title"] = "Eliminar Tipo de Inmueble";
}

<h1>Eliminar Tipo de Inmueble</h1>

<hr />

<div class="alert alert-warning">
    ¿Está seguro que desea eliminar este Tipo de Inmueble?
</div>

<div class="card" style="max-width: 600px;">
    <div class="card-body">

        <p>
            <strong>ID:</strong>
            @Model.id
        </p>

        <p>
            <strong>Nombre:</strong>
            @Model.Nombre
        </p>

        <p>
            <strong>Descripción:</strong>
            @Model.Descripcion
        </p>

        <form asp-action="ConfirmarEliminar"
              asp-route-id="@Model.id"
              method="post">

            <button type="submit"
                    class="btn btn-danger">
                Eliminar
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

        </form>

    </div>
</div>