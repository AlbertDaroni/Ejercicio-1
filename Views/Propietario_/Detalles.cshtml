@using System.Security.Claims
@model Inmobiliaria_.Net_Core.Models.Propietario

@{ ViewData["Title"] = "Detalles del propietario"; }

<h1>Detalles del propietario</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Apellido</dt>
    <dd class="col-sm-9">@Model.Apellido</dd>

    <dt class="col-sm-3">DNI</dt>
    <dd class="col-sm-9">@Model.DNI</dd>

    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@Model.Telefono</dd>

    <dt class="col-sm-3">Correo</dt>
    <dd class="col-sm-9">@Model.Correo</dd>
</dl>

<div>
    @if (Model.id.ToString() == User.FindFirst(ClaimTypes.NameIdentifier)?.Value || User.IsInRole("Administrador")) {
        <a asp-action="Modificar" asp-route-id="@Model.id" class="btn btn-warning">Editar</a>
    }
    <button type="button" onclick="history.back()" class="btn btn-secondary">Volver</button>
</div>