@using System.Security.Claims
@model IEnumerable<Inmobiliaria_.Net_Core.Models.Propietario>

@{ ViewData["Title"] = "Propietarios"; }

<h1>Propietarios</h1>

@if (TempData["Mensaje"] != null) {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<p><a asp-action="Crear" asp-route-ID_Usuario="@User.FindFirst(ClaimTypes.NameIdentifier)?.Value" class="btn btn-primary">Nuevo propietario</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>DNI</th>
            <th>Teléfono</th>
            <th>Correo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var propietario in Model) {
            <tr>
                <td>@propietario.Nombre</td>
                <td>@propietario.Apellido</td>
                <td>@propietario.DNI</td>
                <td>@propietario.Telefono</td>
                <td>@propietario.Correo</td>
                <td>
                    @if (propietario.Correo == User.FindFirst(ClaimTypes.Email)?.Value || User.IsInRole("Administrador")) {
                        <a asp-action="Modificar" asp-route-id="@propietario.id" class="btn btn-warning">Editar</a>
                        <text> | </text>
                    }
                    <a asp-action="Detalles" asp-route-id="@propietario.id" class="btn btn-info btn-sm">Detalles</a>
                    @if (User.IsInRole("Administrador")) {
                        <text> | </text>
                        <a asp-action="Eliminar" asp-route-id="@propietario.id" class="btn btn-danger">Eliminar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>