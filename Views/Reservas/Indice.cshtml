@model IEnumerable<Inmobiliaria_.Net_Core.Models.Reserva>

@{ ViewData["Title"] = "Reservas"; }

<h1>Reservas</h1>

@if (TempData["Mensaje"] != null) {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<p><a asp-action="Crear" class="btn btn-primary">Nueva Reserva</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Fecha de creación</th>
            <th>Fecha de inicio</th>
            <th>Fecha fin original</th>
            <th>Fecha fin efectiva</th>
            <th>Monto</th>
            <th>Multa</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var reserva in Model) {
            <tr>
                <td>@reserva.Fecha_Creacion</td>
                <td>@reserva.Fecha_Inicio</td>
                <td>@reserva.Fecha_Fin_Original</td>
                <td>@reserva.Fecha_Fin_Efectiva</td>
                <td>@reserva.Monto_Dia</td>
                <td>@reserva.Multa</td>
                <td>@reserva.Estado</td>

                <td>
                    <a asp-action="Modificar" asp-route-id="@reserva.id">Editar</a>
                    |
                    <a asp-action="Detalles" asp-route-id="@reserva.id">Detalles</a>
                    |
                    <a asp-action="Elimianr" asp-route-id="@reserva.id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>