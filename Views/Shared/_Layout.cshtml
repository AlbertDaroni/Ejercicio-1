@using System.Security.Claims

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inmobiliaria</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ejercicio_1.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <h4><a class="nav-link text-dark" asp-controller="Home_" asp-action="Index">Sistema Inmobiliario</a></h4>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Inmueble_" asp-action="Indice">Inmuebles</a></li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated) {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Reserva_" asp-action="Indice">Reservas</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Pago_" asp-action="Indice">Pagos</a></li>
                        }
                        
                        @if (User.IsInRole("Administrador")) {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Propietario_" asp-action="Indice">Propietarios</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Tipo_Inmueble_" asp-action="Indice">Tipos de Inmuebles</a></li>
                        }                      

                        @if (User.Identity != null && User.Identity.IsAuthenticated) {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Usuario_" asp-action="Detalles" asp-route-id="@User.FindFirst(ClaimTypes.NameIdentifier)?.Value">
                                    <img src="@User.FindFirst(ClaimTypes.Uri)?.Value" width="50">
                                    <span class="nav-link text-success">Hola, @User.Identity.Name</span>
                                </a>
                            </li>
                        } else {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Cuenta_" asp-action="Login">Iniciar sesión</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Cuenta_" asp-action="SignUp">Registrarse</a></li>
                        }
                    </ul>                    
                </div>
            </div>
        </nav>
    </header>
    <div class="container"><main role="main" class="pb-3">@RenderBody()</main></div>

    <footer class="border-top footer text-muted">
        <div class="container">&copy; 2026 - Proyecto Inmobiliario - <a asp-area="" asp-controller="Home_" asp-action="Privacy">Privacidad</a></div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>