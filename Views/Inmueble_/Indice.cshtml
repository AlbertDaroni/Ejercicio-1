@using System.Security.Claims
@model IEnumerable<Inmobiliaria_.Net_Core.Models.Inmueble>

@{ ViewData["Title"] = "Inmuebles"; }

<h1>Inmuebles</h1>

@if (TempData["Mensaje"] != null) {
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (User.Identity != null && User.Identity.IsAuthenticated) {
    <p><a asp-action="Crear" class="btn btn-primary">Nuevo Inmueble</a></p>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Dirección</th>
            <th>Cupo</th>
            <th>Latitud</th>
            <th>Longitud</th>
            <th>Precio del día</th>
            <th>Porcentaje de la seña</th>
            <th>Estado</th>
            <th>Tipo de inmueble</th>
            <th>Propietario</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var inmueble in Model) {
            <tr>
                <td>@inmueble.Direccion</td>
                <td>@inmueble.Cupo</td>
                <td>@inmueble.Latitud</td>
                <td>@inmueble.Longitud</td>
                <td>$ @inmueble.Precio_Dia</td>
                <td>% @inmueble.Porcentaje_Seña</td>
                <td>
                    @if (inmueble.Estado == "1") {
                        <span class="badge bg-success">Activo</span>
                    } else {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </td>
                <td>@inmueble.Tipo_Inmueble.Nombre</td>
                <td><a href=/Propietario_/Detalles/@inmueble.Propietario.id>@(inmueble.Propietario.ApellidoYNombre)</a></td>
                <td>
                    <a asp-action="Detalles" asp-route-id="@inmueble.id" class="btn btn-info btn-sm">Detalles</a>
                    @if (inmueble.Estado == "1") {
                        <a href="/Reserva_/Crear?ID_Inmueble=@inmueble.id" class="btn btn-primary">Reservar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>