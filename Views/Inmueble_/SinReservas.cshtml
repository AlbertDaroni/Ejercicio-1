@model IEnumerable<Inmobiliaria_.Net_Core.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles sin reservas";

    int dias = ViewBag.Dias;
    int total = ViewBag.Total;
    int pagina = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
}

<h1>Inmuebles sin reservas</h1>

<p>
    Consultá los inmuebles que no tuvieron reservas
    durante los últimos X días.
</p>

<form asp-action="SinReservas" method="get" class="mb-4">
    <div class="row align-items-end">
        <div class="col-md-3">
            <label for="dias" class="form-label">
                Cantidad de días
            </label>

            <input type="number"
                   id="dias"
                   name="dias"
                   value="@dias"
                   min="1"
                   max="3650"
                   required
                   class="form-control" />
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">
                Buscar
            </button>
        </div>
    </div>
</form>

<p>
    <strong>Período:</strong>
    @ViewBag.Desde.ToString("dd/MM/yyyy")
    al
    @ViewBag.Hasta.ToString("dd/MM/yyyy")
</p>

<p>
    <strong>Total de inmuebles encontrados:</strong> @total
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No se encontraron inmuebles sin reservas
        durante el período seleccionado.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Dirección</th>
                <th>Propietario</th>
                <th>Tipo</th>
                <th>Precio por día</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var inmueble in Model)
            {
                <tr>
                    <td>@inmueble.Direccion</td>

                    <td>
                        @inmueble.Propietario?.Apellido,
                        @inmueble.Propietario?.Nombre
                    </td>

                    <td>@inmueble.Tipo_Inmueble?.Nombre</td>

                    <td>@inmueble.Precio_Dia.ToString("C")</td>

                    <td>
                        @if (inmueble.Estado == "1")
                        {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inactivo
                            </span>
                        }
                    </td>

                    <td>
                        <a asp-action="Detalles"
                           asp-route-id="@inmueble.id"
                           class="btn btn-info btn-sm">
                            Ver inmueble
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (totalPaginas > 1)
{
    <nav class="d-flex align-items-center gap-3">

        @if (pagina > 1)
        {
            <a asp-action="SinReservas"
               asp-route-dias="@dias"
               asp-route-pagina="@(pagina - 1)"
               class="btn btn-outline-primary">
                Anterior
            </a>
        }

        <span>
            Página @pagina de @totalPaginas
        </span>

        @if (pagina < totalPaginas)
        {
            <a asp-action="SinReservas"
               asp-route-dias="@dias"
               asp-route-pagina="@(pagina + 1)"
               class="btn btn-outline-primary">
                Siguiente
            </a>
        }
    </nav>
}

<a asp-action="Indice" class="btn btn-secondary mt-3">
    Volver a inmuebles
</a>