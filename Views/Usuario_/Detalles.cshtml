@model Inmobiliaria_.Net_Core.Models.Usuario

@{ ViewData["Title"] = "Detalles del Usuario"; }

<h1>Detalles del Usuario</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Apellido</dt>
    <dd class="col-sm-9">@Model.Apellido</dd>

    <dt class="col-sm-3">Correo</dt>
    <dd class="col-sm-9">@Model.Correo</dd>

    <dt class="col-sm-3">Avatar</dt>
    <dd class="col-sm-9"><img src="@Model.Avatar" width="50"></dd>

    <dt class="col-sm-3">Rol</dt>
    <dd class="col-sm-9">@Model.Rol</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">
        @if (Model.Estado == "1") {
            <span class="badge bg-success">Activo</span>
        } else {
            <span class="badge bg-danger">Inactivo</span>
        }
    </dd>
</dl>

<a asp-action="Modificar" asp-route-id="@Model.id" class="btn btn-warning">Editar</a>
<a asp-action="Eliminar" asp-route-id="@Model.id" class="btn btn-danger btn-sm">Eliminar</a>
<form asp-controller="Cuenta_" asp-action="Logout" method="post" class="d-inline">
    <button type="submit" class="btn btn-danger btn-sm">Cerrar sesión</button>
</form>
<button type="button" onclick="history.back()" class="btn btn-secondary">Volver</button>