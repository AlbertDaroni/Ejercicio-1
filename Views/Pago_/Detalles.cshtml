@model Inmobiliaria_.Net_Core.Models.Pago

@{ ViewData["Title"] = "Detalles del Pago"; }

<h1>Detalles del Pago</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">Concepto</dt>
    <dd class="col-sm-9">@Model.Concepto</dd>

    <dt class="col-sm-3">Fecha de pago</dt>
    <dd class="col-sm-9">@Model.Fecha_Pago.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Importe</dt>
    <dd class="col-sm-9">@Model.Importe.ToString("C")</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">
        @if (Model.Estado == "1") {
            <span class="badge bg-success">Activo</span>
        } else {
            <span class="badge bg-danger">Anulado</span>
        }
    </dd>

    <dt class="col-sm-3">Reserva</dt>
    <dd class="col-sm-9">@Model.ID_Reserva</dd>

    @if (User.IsInRole("Administrador")) {
        <dt class="col-sm-3">Usuario creador</dt>
        <dd class="col-sm-9">@Model.ID_Usuario_Creador</dd>

        <dt class="col-sm-3">Fecha de anulación</dt>
        <dd class="col-sm-9">
            @(Model.Fecha_Anulacion.HasValue
                ? Model.Fecha_Anulacion.Value.ToString("dd/MM/yyyy HH:mm")
                : "No anulado")
        </dd>

        <dt class="col-sm-3">Usuario que anuló</dt>
        <dd class="col-sm-9">
            @(Model.ID_Usuario_Finalizador.HasValue
                ? Model.ID_Usuario_Finalizador.ToString()
                : "-")
        </dd>
    }
</dl>

<a asp-action="Modificar" asp-route-id="@Model.id" class="btn btn-warning">Editar</a>
<a asp-action="Indice" class="btn btn-secondary">Volver</a>