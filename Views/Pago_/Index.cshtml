@model IEnumerable<Inmobiliaria_.Net_Core.Models.Pago>

@{
    ViewData["Title"] = "Pagos";
}

<h1>Pagos</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<p>
    <a asp-action="Crear" class="btn btn-primary">Nuevo Pago</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Concepto</th>
            <th>Fecha de pago</th>
            <th>Importe</th>
            <th>Estado</th>
            <th>Reserva</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var pago in Model)
        {
            <tr>
                <td>@pago.Concepto</td>
                <td>@pago.Fecha_Pago.ToString("dd/MM/yyyy")</td>
                <td>$ @pago.Importe.ToString("N2")</td>
                <td>@pago.Estado</td>
                <td>@pago.ID_Reserva</td>
                <td>
                    <a asp-action="Modificar"
                    asp-route-id="@pago.id"
                    class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Detalles"
                    asp-route-id="@pago.id"
                    class="btn btn-info btn-sm">
                        Detalles
                    </a>

                    <a asp-action="Eliminar"
                    asp-route-id="@pago.id"
                    class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>