@model Inmobiliaria_.Net_Core.Models.Pago

@{ ViewData["Title"] = "Modificar Pago"; }

<h1>Modificar Pago</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Modificar" method="post">
            <input type="hidden" asp-for="id" />

            <div class="mb-3">
                <label asp-for="Concepto" class="form-label">Concepto</label>
                <input asp-for="Concepto" class="form-control">
                <span asp-validation-for="Concepto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Fecha_Pago" class="form-label">Fecha de pago</label>
                <input asp-for="Fecha_Pago" type="date" class="form-control">
                <span asp-validation-for="Fecha_Pago" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Importe" class="form-label">Importe</label>
                <input asp-for="Importe" class="form-control">
                <span asp-validation-for="Importe" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ID_Reserva" class="form-label">Reserva</label>
                <input asp-for="ID_Reserva" class="form-control">
                <span asp-validation-for="ID_Reserva" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Indice" class="btn btn-secondary">Volver</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}