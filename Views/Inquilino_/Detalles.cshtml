@model Inmobiliaria_.Net_Core.Models.Inquilino

@{ ViewData["Title"] = "Eliminar inquilino"; }

<h1>Eliminar inquilino</h1>
<h3>¿Está seguro que desea eliminar este inquilino?</h3>

<hr />

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Apellido</dt>
    <dd class="col-sm-9">@Model.Apellido</dd>

    <dt class="col-sm-3">DNI</dt>
    <dd class="col-sm-9">@Model.DNI</dd>

    <dt class="col-sm-3">Telefono</dt>
    <dd class="col-sm-9">@Model.Telefono</dd>

    <dt class="col-sm-3">Correo</dt>
    <dd class="col-sm-9">@Model.Correo</dd>
</dl>

<div>
    <a asp-action="Modificar" asp-route-id="@Model.id" class="btn btn-warning">Editar</a>
    @if (User.IsInRole("Administrador")) {                 
        <a asp-action="Eliminar" asp-route-id="@Model.id" class="btn btn-danger">Eliminar</a>
    }
    <button type="button" onclick="history.back()" class="btn btn-secondary">Volver</button>
</div>